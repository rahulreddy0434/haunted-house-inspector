# AWS region for all services (us-east-2 recommended)
APP_AWS_REGION=us-east-2

# Amazon Bedrock model or cross-region inference profile ID
# For Amazon Nova Lite in us-east-2 use the cross-region profile: us.amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# S3 bucket name for uploaded images and video frames
S3_BUCKET_NAME=

# DynamoDB table name for inspection jobs
DYNAMODB_TABLE_NAME=

# Shared demo access code for the tradesperson dashboard
PRO_ACCESS_CODE=

# Public base URL for the app (e.g. https://yourapp.amplifyapp.com)
NEXT_PUBLIC_APP_URL=
